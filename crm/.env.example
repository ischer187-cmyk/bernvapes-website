# Copy to crm/.env for the later Docker/Hetzner step.
# On the Mac, export these in the terminal instead. Leave DATABASE_URL empty.

# --- required before the first start ---
CRM_ADMIN_EMAIL=dominic@example.com
CRM_ADMIN_PASSWORD=change-me-at-least-10
CRM_WEBHOOK_SECRET=change-me-long-random

# Local SQLite (default). Do not set DATABASE_URL until the Hetzner move.
CRM_SQLITE_PATH=./crm.db
# DATABASE_URL=postgresql://bernvapes:change-me@postgres:5432/bernvapes

CRM_BIND=127.0.0.1
CRM_PORT=18734
# Inside Docker only: CRM_BIND=0.0.0.0 and CRM_ALLOW_PUBLIC_BIND=1
# CRM_ALLOW_PUBLIC_BIND=0

# Invite links open on the local website.
WEBSITE_PUBLIC_URL=http://127.0.0.1:8080

# http://127.0.0.1 does not want Secure cookies. Set to 1 only behind HTTPS later.
CRM_COOKIE_SECURE=0

# Email: log (default) writes crm/mail.log and the CRM screen. Nothing is sent.
# There is no SMTP driver in this build.
EMAIL_DRIVER=log

# bexio writes stay off. The stub never calls the bexio API.
BEXIO_WRITE_ENABLED=0

# Website (serve_local.py). false = Endkunden-Login only. Händler code stays, page says Chunnt bald.
# B2B_ENABLED=false

# Optional, only for the existing read-only classify_contacts.py --refresh
# BEXIO_API_TOKEN=

# How long an invite link works.
INVITE_TTL_DAYS=14
